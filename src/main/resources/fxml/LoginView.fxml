<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.restaurant.inventory.controller.LoginController"
           styleClass="login-root">

    <HBox alignment="CENTER" maxWidth="960" maxHeight="640" styleClass="login-card-container">
        <!-- ================= LEFT BRAND PANEL ================= -->
        <VBox prefWidth="420" spacing="18" styleClass="login-brand-panel" HBox.hgrow="NEVER">
            <padding>
                <Insets top="36" right="32" bottom="36" left="32"/>
            </padding>

            <VBox spacing="6">
                <Label text="🍽 The Gourmet Kitchen" styleClass="login-brand-title"/>
                <Label text="Restaurant Menu &amp; Inventory Management" styleClass="login-brand-subtitle"/>
            </VBox>

            <Separator styleClass="login-separator"/>

            <VBox spacing="12">
                <Label text="System Features &amp; Access:" styleClass="login-features-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👑" styleClass="emoji-badge"/>
                    <VBox>
                        <Label text="Administrator Access" styleClass="feature-heading"/>
                        <Label text="Create accounts, manage menu photos, track stock, purchase supplies" styleClass="feature-desc" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" styleClass="emoji-badge"/>
                    <VBox>
                        <Label text="Standard Customer View" styleClass="feature-heading"/>
                        <Label text="Explore delicious dishes, photos &amp; real-time availability" styleClass="feature-desc" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="⚠" styleClass="emoji-badge"/>
                    <VBox>
                        <Label text="Smart Inventory Warnings" styleClass="feature-heading"/>
                        <Label text="Instant alerts on ingredient shortages &amp; purchase needs" styleClass="feature-desc" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Demo helper card -->
            <VBox spacing="8" styleClass="demo-credentials-box">
                <Label text="Demo Accounts for Testing:" styleClass="demo-title"/>
                <Label text="• Admin: admin / admin123" styleClass="demo-text"/>
                <Label text="• User: user or ayesha (no password needed)" styleClass="demo-text"/>
            </VBox>
        </VBox>

        <!-- ================= RIGHT LOGIN FORM PANEL ================= -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="login-scroll-pane" prefWidth="540" HBox.hgrow="ALWAYS">
            <content>
                <VBox spacing="16" styleClass="login-form-panel">
                    <padding>
                        <Insets top="36" right="40" bottom="36" left="40"/>
                    </padding>

                    <VBox spacing="4">
                        <Label text="Sign In" styleClass="login-header"/>
                        <Label text="Welcome back! Please enter your details below." styleClass="login-subheader"/>
                    </VBox>

                    <!-- WARNING BANNER (Shown for incorrect or empty inputs) -->
                    <HBox fx:id="warningBanner" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10" styleClass="warning-banner">
                        <Label text="⚠" styleClass="warning-icon"/>
                        <Label fx:id="warningLabel" text="" styleClass="warning-text" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Button text="✕" styleClass="banner-dismiss-btn" onAction="#onDismissWarning"/>
                    </HBox>

                    <!-- Username Field -->
                    <VBox spacing="6">
                        <Label text="Username" styleClass="input-label"/>
                        <TextField fx:id="usernameField" promptText="Enter your username" styleClass="modern-input"/>
                    </VBox>

                    <!-- Password Field with Show/Hide -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Password" styleClass="input-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="(Admin only - not needed for users)" styleClass="text-muted" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="Admin password (leave blank for users)" styleClass="modern-input"/>
                                <TextField fx:id="passwordPlainField" promptText="Admin password (leave blank for users)" styleClass="modern-input" visible="false" managed="false"/>
                            </StackPane>
                            <Button fx:id="showPasswordBtn" text="Show" onAction="#onTogglePassword" styleClass="secondary-btn"/>
                        </HBox>
                    </VBox>

                    <!-- Sign In Action Button -->
                    <Button text="Sign In to System" onAction="#onLogin" styleClass="modern-primary-btn" maxWidth="Infinity"/>

                    <!-- Admin-only: Create Account Section -->
                    <VBox fx:id="adminCreateSection" visible="false" managed="false" spacing="10" styleClass="register-card">
                        <Label text="👑 Create New Account" styleClass="admin-create-title"/>
                        <Label text="Enter the admin password to create an account." styleClass="text-muted" wrapText="true"/>
                        <VBox spacing="4">
                            <Label text="Admin Password" styleClass="input-label"/>
                            <PasswordField fx:id="adminAuthField" promptText="Admin password required" styleClass="modern-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="New Username" styleClass="input-label"/>
                            <TextField fx:id="regUsernameField" promptText="Desired username" styleClass="modern-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Full Name" styleClass="input-label"/>
                            <TextField fx:id="regFullNameField" promptText="Full name" styleClass="modern-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Role" styleClass="input-label"/>
                            <ComboBox fx:id="regRoleCombo" maxWidth="Infinity" styleClass="modern-combo"/>
                        </VBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Create Account" onAction="#onRegister" styleClass="modern-primary-btn"/>
                            <Button text="Cancel" onAction="#onCancelCreate" styleClass="secondary-btn"/>
                        </HBox>
                        <Label fx:id="regMessageLabel" wrapText="true"/>
                    </VBox>

                    <!-- Admin create account toggle -->
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Administrator?" styleClass="text-muted"/>
                        <Button text="Create Account" onAction="#onToggleRegister" styleClass="link-btn"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</StackPane>
