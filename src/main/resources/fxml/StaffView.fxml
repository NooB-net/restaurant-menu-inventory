<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.inventory.controller.StaffController"
            styleClass="view-root">
    <padding>
        <Insets top="12" right="12" bottom="8" left="12"/>
    </padding>

    <!-- ============ LEFT: registration form ============ -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="340">
            <content>
                <VBox spacing="10" styleClass="modern-card">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <!-- ToggleGroups -->
                    <fx:define>
                        <ToggleGroup fx:id="genderGroup"/>
                        <ToggleGroup fx:id="skillGroup"/>
                    </fx:define>

                    <Label text="Register a Staff Member" styleClass="card-section-title"/>

                    <VBox spacing="4">
                        <Label text="Full Name" styleClass="field-label"/>
                        <TextField fx:id="nameField" promptText="Full name" styleClass="modern-input"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Gender" styleClass="field-label"/>
                        <HBox spacing="14">
                            <RadioButton text="Male" toggleGroup="$genderGroup"/>
                            <RadioButton text="Female" toggleGroup="$genderGroup"/>
                            <RadioButton text="Other" toggleGroup="$genderGroup"/>
                        </HBox>
                        <Label fx:id="genderLabel" styleClass="info-label"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Kitchen Skill Level" styleClass="field-label"/>
                        <HBox spacing="14">
                            <RadioButton fx:id="beginnerRadio" text="Beginner" toggleGroup="$skillGroup"/>
                            <RadioButton text="Intermediate" toggleGroup="$skillGroup"/>
                            <RadioButton text="Expert" toggleGroup="$skillGroup"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Country" styleClass="field-label"/>
                        <ComboBox fx:id="countryCombo" promptText="Select a country" prefWidth="300" styleClass="modern-combo"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Date of Birth" styleClass="field-label"/>
                        <DatePicker fx:id="dobPicker" promptText="Pick a date" prefWidth="300" styleClass="modern-date-picker"/>
                        <Label fx:id="dobLabel" styleClass="info-label"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Photo" styleClass="field-label"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane styleClass="photo-frame" minWidth="80" minHeight="80" prefWidth="80" prefHeight="80"
                                       maxWidth="80" maxHeight="80">
                                <ImageView fx:id="photoView" fitWidth="78" fitHeight="78" preserveRatio="true"/>
                            </StackPane>
                            <VBox spacing="6">
                                <Button text="Browse Photo..." onAction="#onBrowsePhoto" styleClass="secondary-btn"/>
                                <Label fx:id="photoNameLabel" wrapText="true" maxWidth="180" styleClass="text-muted"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Button text="Submit Staff Member" styleClass="modern-primary-btn" onAction="#onSubmit" maxWidth="Infinity"/>
                    <Label fx:id="formMessageLabel" styleClass="info-label" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- ============ CENTER: staff table ============ -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets left="14"/>
            </padding>
            <Label text="Staff Directory" styleClass="page-title"/>
            <TableView fx:id="staffTable" VBox.vgrow="ALWAYS" styleClass="modern-table" fixedCellSize="62">
                <columns>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="140"/>
                    <TableColumn fx:id="genderCol" text="Gender" prefWidth="75"/>
                    <TableColumn fx:id="skillCol" text="Skill" prefWidth="100"/>
                    <TableColumn fx:id="countryCol" text="Country" prefWidth="120"/>
                    <TableColumn fx:id="dobCol" text="Date of Birth" prefWidth="130"/>
                    <TableColumn fx:id="photoCol" text="Photo" prefWidth="90"/>
                </columns>
            </TableView>
            <HBox>
                <Button text="Remove Selected" onAction="#onRemoveStaff" styleClass="danger-btn"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
